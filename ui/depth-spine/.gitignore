# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The built frontend is committed on purpose: Streamlit Community Cloud has no
# npm, so the component serves this directory as-is. This negation overrides
# the repository-root `dist/` rule.
!dist/
!dist/**

# The inline build's real home is inside the Python package
# (src/groundwater/depth_spine/static/), placed there by scripts/place-static.mjs.
# Committing this intermediate too would ship the same 250 KB twice.
dist-inline
