__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
~$*

# Secrets - never commit an API key. Streamlit reads local secrets from
# .streamlit/secrets.toml, which sits beside the tracked config.toml.
.streamlit/secrets.toml
.env
*.env
secrets.toml

# Virtualenvs, coverage and editor/OS cruft
.venv/
venv/
env/
.coverage
htmlcov/
.DS_Store
.vscode/
.idea/

# Node test tooling (Playwright is installed globally in CI)
node_modules

# Knife edges a fuzz run found; one is kept by moving it up a folder
tests/fuzz/knife-edges/found/

# Example packs are built from files that are already committed
# (python examples/build_catalogue.py), so a second copy would only go stale.
examples/packs/

# The real-tile acceptance (tests/test_real_tile.py, tests/webapp/realtile.mjs)
# runs locally on a downloaded elevation tile, 48 MB under a licence of its
# own, and writes what the browser must reproduce here. Neither is committed.
tests/acceptance/*.tif
tests/acceptance/*.json
